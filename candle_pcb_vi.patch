+      probe: P('g', 'probe'), plate: P('g', 'plate'), probeRange: P('g', 'probeRange'), probeFeed: P('g', 'probeFeed'),
+      tcZ: P('g', 'tcZ'), spin: P('g', 'spin'), probeFirst: P('g', 'probeFirst'), probeAt: P('g', 'probeAt'), probeX: P('g', 'probeX'), probeY: P('g', 'probeY'),
+      probeFast: P('g', 'probeFast'), probeLift: P('g', 'probeLift'), probePause: P('g', 'probePause'), noArc: P('g', 'noArc')
