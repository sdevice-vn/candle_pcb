+        if (pl.info.narrow > 0.05) warns.push('Có khoảng ' + pl.info.narrow.toFixed(2) + ' mm² khe đồng hẹp hơn mũi phay ' + PCB.fmt(eo.toolDia) + ' mm nên không phay được. Kiểm tra lại khoảng cách giữa các đường mạch.');
