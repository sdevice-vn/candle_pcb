+#ifndef FRMGERBER_H
+#define FRMGERBER_H
+
+#include <QDialog>
+#include <QJsonArray>
+#include <QJsonObject>
+#include <QMap>
+#include <QThread>
+#include <QTimer>
+#include <QVariantMap>
+
+class QCheckBox;
+class QComboBox;
+class QDoubleSpinBox;
+class QGroupBox;
+class QLabel;
+class QPushButton;
+class QTableWidget;
+class QVBoxLayout;
+class PcbPreview;
+class PcbWorker;
+
+// "Gerber -> G-code" window: loads the Gerber/drill/outline files, shows the parameters
+// and a preview, and sends the generated G-code to the main Candle window.
+class frmGerber : public QDialog
+{
+    Q_OBJECT
+public:
+    explicit frmGerber(const QString &settingsFile, QWidget *parent = 0);
+    ~frmGerber();
+
+    // Used by tests / automation
+    bool setFileFromPath(const QString &path, const QString &forceKind = QString());
+    void setParam(const QString &key, const QVariant &value);
+    QString currentGcode() const;
+
+signals:
+    void loadGcode(const QStringList &lines, const QString &title);
+    void requestRun(const QVariantMap &files, const QVariantMap &params, int token);
+    void computed(bool ok);
+
+protected:
+    void dragEnterEvent(QDragEnterEvent *e);
+    void dropEvent(QDropEvent *e);
+    void closeEvent(QCloseEvent *e);
+
+private slots:
+    void onParamChanged();
+    void startCompute();
+    void onResult(const QString &json, int token);
+    void onPickFile(const QString &kind);
+    void onClearFile(const QString &kind);
+    void onLoadClicked();
+    void onSaveClicked();
+    void onSaveParams();
+    void onLoadParams();
+    void onResetParams();
+
+private:
+    struct Slot {
+        QLabel *status;
+        QPushButton *pick;
+        QPushButton *clear;
+        QString name;
+        QString text;
+    };
+
+    void buildUi();
+    QWidget *buildParamsWidget();
+    QWidget *buildFilesWidget();
+    QVariant paramValue(const QString &key) const;
+    void setParamValue(const QString &key, const QVariant &v);
+    QVariantMap allParams() const;
+    void syncEnabled();
+    void saveSettings();
+    void loadSettings();
+    QString classify(const QString &name, const QString &text) const;
+    bool setFile(const QString &kind, const QString &name, const QString &text);
+    void showResult(const QJsonObject &r);
+    void showMessage(const QString &text);
+    QStringList selectedGcodeLines(QString *title, QString *fileName) const;
+
+    QString m_settingsFile;
+    QJsonArray m_groups;
+
+    QMap<QString, Slot> m_slots;
+    QMap<QString, QWidget *> m_widgets;      // key -> input widget
+    QMap<QString, QVariant> m_defaults;
+
+    PcbPreview *m_preview;
+    QLabel *m_coord;
+    QLabel *m_warns;
+    QLabel *m_summary;
+    QLabel *m_status;
+    QTableWidget *m_stagesTable;
+    QTableWidget *m_holesTable;
+    QComboBox *m_cboLoad;
+    QPushButton *m_cmdLoad;
+    QPushButton *m_cmdSave;
+    QList<QCheckBox *> m_layerChecks;
+
+    QThread m_thread;
+    PcbWorker *m_worker;
+    QTimer m_timer;
+    int m_token;
+    int m_pendingToken;
+    bool m_busy;
+    bool m_dirty;
+    bool m_loading;
+    QString m_lastDir;
+
+    // last result
+    QString m_combined;
+    QStringList m_parts;
+    QStringList m_partTitles;
+    QString m_probe;
+};
+
+#endif // FRMGERBER_H
