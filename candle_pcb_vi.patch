+        stages.push({ id: 'engrave', key: 'eng', title: 'Phay đồng thừa', toolText: vb ? ('mũi V góc ' + PCB.fmt(P('e', 'vang')) + ' (rộng ' + PCB.fmt(effDia) + ' mm ở độ sâu ' + PCB.fmt(P('e', 'depth')) + ' mm)') : ('mũi phay ' + PCB.fmt(eo.toolDia) + ' mm'), rpm: P('e', 'rpm'), w: w,
