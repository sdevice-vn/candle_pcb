+#ifndef PCBWORKER_H
+#define PCBWORKER_H
+
+#include <QObject>
+#include <QVariantMap>
+#include <QJSEngine>
+#include <QJSValue>
+
+// Runs the PCB engine (Clipper + Gerber/Excellon parser + G-code generator, JavaScript)
+// inside a QJSEngine. Lives in its own thread; the engine is created lazily in that thread.
+class PcbNative;
+
+class PcbWorker : public QObject
+{
+    Q_OBJECT
+public:
+    explicit PcbWorker(QObject *parent = 0);
+    ~PcbWorker();
+
+    // Synchronous helper (used by the self test and tools)
+    QString runNow(const QVariantMap &files, const QVariantMap &params);
+
+public slots:
+    void run(const QVariantMap &files, const QVariantMap &params, int token);
+
+signals:
+    void finished(const QString &json, int token);
+
+private:
+    bool ensureEngine(QString *error);
+    QString loadResource(const QString &path);
+
+    QJSEngine *m_engine;
+    PcbNative *m_native;
+    QJSValue m_fn;
+};
+
+#endif // PCBWORKER_H
