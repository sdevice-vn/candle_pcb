diff --git a/src/gerber/pcbnative.cpp b/src/gerber/pcbnative.cpp
new file mode 100644
index 0000000..78f983b
--- /dev/null
+++ b/src/gerber/pcbnative.cpp
@@ -0,0 +1,69 @@
+#include "pcbnative.h"
+#include "clipper/clipper.hpp"
+
+#include <cstring>
+#include <vector>
+
+using namespace ClipperLib;
+
+static void unpackPaths(const QByteArray &buf, Paths &out)
+{
+    out.clear();
+    if (buf.size() < 4) return;
+    const qint32 *a = reinterpret_cast<const qint32 *>(buf.constData());
+    const qint32 *end = a + buf.size() / 4;
+    int np = *a++;
+    out.reserve(np);
+    for (int i = 0; i < np && a < end; i++) {
+        int n = *a++;
+        if (n < 0 || a + 2 * (qint64)n > end) break;
+        Path p;
+        p.resize(n);
+        for (int j = 0; j < n; j++) {
+            p[j].X = a[2 * j];
+            p[j].Y = a[2 * j + 1];
+        }
+        a += 2 * n;
+        out.push_back(p);
+    }
+}
+
+static QByteArray packPaths(const Paths &paths)
+{
+    size_t total = 1 + paths.size();
+    for (size_t i = 0; i < paths.size(); i++) total += 2 * paths[i].size();
+    QByteArray buf;
+    buf.resize(int(total * 4));
+    qint32 *a = reinterpret_cast<qint32 *>(buf.data());
+    *a++ = qint32(paths.size());
+    for (size_t i = 0; i < paths.size(); i++) {
+        *a++ = qint32(paths[i].size());
+        for (size_t j = 0; j < paths[i].size(); j++) {
+            *a++ = qint32(paths[i][j].X);
+            *a++ = qint32(paths[i][j].Y);
+        }
+    }
+    return buf;
+}
+
+QByteArray PcbNative::boolOp(const QByteArray &subj, const QByteArray &clip, int clipType, int fillType)
+{
+    Paths s, c, sol;
+    unpackPaths(subj, s);
+    unpackPaths(clip, c);
+    Clipper cl;
+    if (!s.empty()) cl.AddPaths(s, ptSubject, true);
+    if (!c.empty()) cl.AddPaths(c, ptClip, true);
+    cl.Execute(ClipType(clipType), sol, PolyFillType(fillType), PolyFillType(fillType));
+    return packPaths(sol);
+}
+
+QByteArray PcbNative::offset(const QByteArray &paths, double delta, int open, double arcTolerance)
+{
+    Paths p, sol;
+    unpackPaths(paths, p);
+    ClipperOffset co(2, arcTolerance);
+    co.AddPaths(p, jtRound, open ? etOpenRound : etClosedPolygon);
+    co.Execute(sol, delta);
+    return packPaths(sol);
+}
diff --git a/src/gerber/pcbnative.h b/src/gerber/pcbnative.h
new file mode 100644
index 0000000..b2bea5b
--- /dev/null
+++ b/src/gerber/pcbnative.h
@@ -0,0 +1,19 @@
+#ifndef PCBNATIVE_H
+#define PCBNATIVE_H
+
+#include <QObject>
+#include <QByteArray>
+
+// Native (C++) polygon operations exposed to the JavaScript PCB engine.
+// Paths travel as Int32Array buffers: [pathCount, n0, x,y,x,y..., n1, ...] (Clipper integer units).
+class PcbNative : public QObject
+{
+    Q_OBJECT
+public:
+    explicit PcbNative(QObject *parent = 0) : QObject(parent) {}
+
+    Q_INVOKABLE QByteArray boolOp(const QByteArray &subj, const QByteArray &clip, int clipType, int fillType);
+    Q_INVOKABLE QByteArray offset(const QByteArray &paths, double delta, int open, double arcTolerance);
+};
+
+#endif // PCBNATIVE_H
diff --git a/src/gerber/pcbpreview.cpp b/src/gerber/pcbpreview.cpp
new file mode 100644
index 0000000..538d8c4
--- /dev/null
+++ b/src/gerber/pcbpreview.cpp
@@ -0,0 +1,187 @@
+#include "pcbpreview.h"
+
+#include <QJsonArray>
+#include <QPainter>
+#include <QMouseEvent>
+#include <QWheelEvent>
+#include <QVector4D>
+#include <cmath>
+
+PcbPreview::PcbPreview(QWidget *parent) : QWidget(parent), m_has(false), m_bw(0), m_bh(0), m_bitS(0),
+    m_scale(1), m_drag(false)
+{
+    for (int i = 0; i < 5; i++) m_vis[i] = true;
+    setMinimumSize(320, 240);
+    setMouseTracking(true);
+    setCursor(Qt::OpenHandCursor);
+}
+
+QPainterPath PcbPreview::toPath(const QJsonValue &paths, bool close) const
+{
+    QPainterPath p;
+    p.setFillRule(Qt::OddEvenFill);
+    QJsonArray all = paths.toArray();
+    for (int i = 0; i < all.size(); i++) {
+        QJsonArray pts = all[i].toArray();
+        if (pts.size() < 2) continue;
+        QJsonArray a = pts[0].toArray();
+        p.moveTo(a[0].toDouble(), a[1].toDouble());
+        for (int j = 1; j < pts.size(); j++) {
+            a = pts[j].toArray();
+            p.lineTo(a[0].toDouble(), a[1].toDouble());
+        }
+        if (close) p.closeSubpath();
+    }
+    return p;
+}
+
+void PcbPreview::setData(const QJsonObject &pv, double bitSmall)
+{
+    m_bw = pv["bw"].toDouble();
+    m_bh = pv["bh"].toDouble();
+    m_bitS = bitSmall;
+    m_board = toPath(pv["board"], true);
+    m_copper = pv.contains("copper") ? toPath(pv["copper"], true) : QPainterPath();
+    m_path = pv.contains("path") ? toPath(pv["path"], true) : QPainterPath();
+    m_clear = pv.contains("clear") ? toPath(pv["clear"], true) : QPainterPath();
+    m_edge = pv.contains("edge") ? toPath(pv["edge"], true) : QPainterPath();
+    m_open = pv.contains("open") ? toPath(pv["open"], false) : QPainterPath();
+    m_holes.clear();
+    QJsonArray hs = pv["holes"].toArray();
+    for (int i = 0; i < hs.size(); i++) {
+        QJsonArray h = hs[i].toArray();
+        m_holes << QVector4D(h[0].toDouble(), h[1].toDouble(), h[2].toDouble(), h[3].toDouble());
+    }
+    bool first = !m_has;
+    m_has = true;
+    if (first) fit();
+    update();
+}
+
+void PcbPreview::clear()
+{
+    m_has = false;
+    update();
+}
+
+void PcbPreview::setLayerVisible(const QString &layer, bool visible)
+{
+    static const char *names[] = { "copper", "path", "clear", "holes", "edge" };
+    for (int i = 0; i < 5; i++) if (layer == names[i]) m_vis[i] = visible;
+    update();
+}
+
+void PcbPreview::fit()
+{
+    if (!m_has) return;
+    double pad = 24;
+    double w = qMax(width() - 2 * pad, 10.0), h = qMax(height() - 2 * pad, 10.0);
+    m_scale = qMin(w / (m_bw + 4), h / (m_bh + 4));
+    m_off = QPointF((width() - m_bw * m_scale) / 2, (height() + m_bh * m_scale) / 2);
+}
+
+QPointF PcbPreview::toWorld(const QPointF &p) const
+{
+    return QPointF((p.x() - m_off.x()) / m_scale, (m_off.y() - p.y()) / m_scale);
+}
+
+void PcbPreview::resizeEvent(QResizeEvent *)
+{
+    fit();
+}
+
+void PcbPreview::paintEvent(QPaintEvent *)
+{
+    QPainter p(this);
+    p.fillRect(rect(), QColor("#071A15"));
+    if (!m_has) {
+        p.setPen(QColor("#8BA39A"));
+        p.drawText(rect(), Qt::AlignCenter, QString::fromUtf8("Chưa có dữ liệu.\nNạp file Gerber để xem trước đường phay."));
+        return;
+    }
+    p.setRenderHint(QPainter::Antialiasing, true);
+    p.translate(m_off);
+    p.scale(m_scale, -m_scale);
+    double px = 1.0 / m_scale;
+
+    p.fillPath(m_board, QColor("#0E3B2F"));
+    if (m_vis[0]) p.fillPath(m_copper, QColor("#CF8A4D"));
+
+    QPen pen;
+    pen.setCosmetic(true);
+    if (m_vis[1] && !m_path.isEmpty()) {
+        pen.setColor(QColor("#A9EBFF")); pen.setWidthF(1.0);
+        p.setPen(pen); p.setBrush(Qt::NoBrush); p.drawPath(m_path);
+    }
+    if (m_vis[2] && !m_clear.isEmpty()) {
+        pen.setColor(QColor("#8FE388")); pen.setWidthF(1.0);
+        p.setPen(pen); p.setBrush(Qt::NoBrush); p.drawPath(m_clear);
+    }
+    if (m_vis[4]) {
+        pen.setColor(QColor(255, 255, 255, 85)); pen.setWidthF(1.0);
+        p.setPen(pen); p.setBrush(Qt::NoBrush); p.drawPath(m_board);
+        if (!m_edge.isEmpty()) {
+            pen.setColor(QColor("#FF5CC8")); pen.setWidthF(1.5);
+            p.setPen(pen); p.drawPath(m_edge);
+        }
+        if (!m_open.isEmpty()) {
+            pen.setColor(QColor("#8BA39A")); pen.setWidthF(1.0); pen.setStyle(Qt::DashLine);
+            p.setPen(pen); p.drawPath(m_open);
+        }
+    }
+    if (m_vis[3]) {
+        pen.setStyle(Qt::SolidLine); pen.setWidthF(1.3);
+        p.setBrush(Qt::NoBrush);
+        foreach (const QVector4D &h, m_holes) {
+            double bit = h.w();
+            QColor c = bit == 0 ? QColor("#8BA39A") : (qAbs(bit - m_bitS) < 1e-6 ? QColor("#FFD54A") : QColor("#FF6B5A"));
+            pen.setColor(c);
+            p.setPen(pen);
+            double r = qMax(double(h.z()) / 2, px * 1.5);
+            p.drawEllipse(QPointF(h.x(), h.y()), r, r);
+        }
+    }
+}
+
+void PcbPreview::wheelEvent(QWheelEvent *e)
+{
+    if (!m_has) return;
+    double f = std::exp(e->angleDelta().y() * 0.0015);
+    double ns = qBound(1.0, m_scale * f, 600.0);
+    QPointF pos = e->pos();
+    QPointF w = toWorld(pos);
+    m_off = QPointF(pos.x() - w.x() * ns, pos.y() + w.y() * ns);
+    m_scale = ns;
+    update();
+}
+
+void PcbPreview::mousePressEvent(QMouseEvent *e)
+{
+    if (!m_has) return;
+    m_drag = true; m_dragPos = e->pos(); m_dragOff = m_off;
+    setCursor(Qt::ClosedHandCursor);
+}
+
+void PcbPreview::mouseMoveEvent(QMouseEvent *e)
+{
+    if (m_has) {
+        QPointF w = toWorld(e->pos());
+        emit coordChanged(QString("X %1  Y %2 mm").arg(w.x(), 0, 'f', 2).arg(w.y(), 0, 'f', 2));
+    }
+    if (m_drag) {
+        m_off = m_dragOff + QPointF(e->pos() - m_dragPos);
+        update();
+    }
+}
+
+void PcbPreview::mouseReleaseEvent(QMouseEvent *)
+{
+    m_drag = false;
+    setCursor(Qt::OpenHandCursor);
+}
+
+void PcbPreview::mouseDoubleClickEvent(QMouseEvent *)
+{
+    fit();
+    update();
+}
diff --git a/src/gerber/pcbpreview.h b/src/gerber/pcbpreview.h
new file mode 100644
index 0000000..f80cff9
--- /dev/null
+++ b/src/gerber/pcbpreview.h
@@ -0,0 +1,52 @@
+#ifndef PCBPREVIEW_H
+#define PCBPREVIEW_H
+
+#include <QWidget>
+#include <QJsonObject>
+#include <QPainterPath>
+#include <QPointF>
+#include <QVector4D>
+#include <QList>
+
+// 2D preview of the board, copper, tool paths, holes and outline (board coordinates, mm).
+class PcbPreview : public QWidget
+{
+    Q_OBJECT
+public:
+    explicit PcbPreview(QWidget *parent = 0);
+
+    void setData(const QJsonObject &preview, double bitSmall);
+    void clear();
+    void setLayerVisible(const QString &layer, bool visible);
+    bool hasData() const { return m_has; }
+
+protected:
+    void paintEvent(QPaintEvent *);
+    void wheelEvent(QWheelEvent *e);
+    void mousePressEvent(QMouseEvent *e);
+    void mouseMoveEvent(QMouseEvent *e);
+    void mouseReleaseEvent(QMouseEvent *e);
+    void mouseDoubleClickEvent(QMouseEvent *e);
+    void resizeEvent(QResizeEvent *);
+
+signals:
+    void coordChanged(const QString &text);
+
+private:
+    QPainterPath toPath(const QJsonValue &paths, bool close) const;
+    void fit();
+    QPointF toWorld(const QPointF &p) const;
+
+    bool m_has;
+    double m_bw, m_bh, m_bitS;
+    QPainterPath m_board, m_copper, m_path, m_clear, m_edge, m_open;
+    QList<QVector4D> m_holes;
+    bool m_vis[5]; // copper, path, clear, holes, edge
+    double m_scale;
+    QPointF m_off; // pixel offset of world origin (bottom-left)
+    bool m_drag;
+    QPoint m_dragPos;
+    QPointF m_dragOff;
+};
+
+#endif // PCBPREVIEW_H
diff --git a/src/gerber/pcbworker.cpp b/src/gerber/pcbworker.cpp
new file mode 100644
index 0000000..75ef55f
--- /dev/null
+++ b/src/gerber/pcbworker.cpp
@@ -0,0 +1,85 @@
+#include "pcbworker.h"
+#include "pcbnative.h"
+
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+
+PcbWorker::PcbWorker(QObject *parent) : QObject(parent), m_engine(NULL), m_native(NULL)
+{
+}
+
+PcbWorker::~PcbWorker()
+{
+    delete m_engine;
+}
+
+QString PcbWorker::loadResource(const QString &path)
+{
+    QFile f(path);
+    if (!f.open(QIODevice::ReadOnly)) return QString();
+    return QString::fromUtf8(f.readAll());
+}
+
+bool PcbWorker::ensureEngine(QString *error)
+{
+    if (m_engine) return true;
+
+    QJSEngine *eng = new QJSEngine();
+    // Native Clipper (C++) for polygon boolean/offset; set PCB_NO_NATIVE=1 to force the pure JS path
+    if (qgetenv("PCB_NO_NATIVE").isEmpty()) {
+        if (!m_native) m_native = new PcbNative(this);
+        eng->globalObject().setProperty("__native", eng->newQObject(m_native));
+    }
+    const char *files[] = { "prelude.js", "clipper.js", "pcb_engine.js", "pcb_compute.js" };
+    for (unsigned i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+        QString name = QString(":/gerber/js/") + files[i];
+        QString src = loadResource(name);
+        if (src.isEmpty()) {
+            *error = QString::fromUtf8("Không đọc được tài nguyên ") + name;
+            delete eng;
+            return false;
+        }
+        QJSValue r = eng->evaluate(src, files[i]);
+        if (r.isError()) {
+            *error = QString("%1:%2: %3").arg(files[i]).arg(r.property("lineNumber").toInt()).arg(r.toString());
+            delete eng;
+            return false;
+        }
+    }
+    m_fn = eng->globalObject().property("pcbRun");
+    if (!m_fn.isCallable()) {
+        *error = QString::fromUtf8("Không tìm thấy hàm pcbRun");
+        delete eng;
+        return false;
+    }
+    m_engine = eng;
+    return true;
+}
+
+QString PcbWorker::runNow(const QVariantMap &files, const QVariantMap &params)
+{
+    QString err;
+    if (!ensureEngine(&err)) {
+        QJsonObject o;
+        o["ok"] = false;
+        o["warns"] = QJsonArray::fromStringList(QStringList() << err);
+        return QString::fromUtf8(QJsonDocument(o).toJson(QJsonDocument::Compact));
+    }
+    QJSValueList args;
+    args << m_engine->toScriptValue(files) << m_engine->toScriptValue(params);
+    QJSValue r = m_fn.call(args);
+    if (r.isError()) {
+        QJsonObject o;
+        o["ok"] = false;
+        o["warns"] = QJsonArray::fromStringList(QStringList() << QString::fromUtf8("Lỗi script: ") + r.toString());
+        return QString::fromUtf8(QJsonDocument(o).toJson(QJsonDocument::Compact));
+    }
+    return r.toString();
+}
+
+void PcbWorker::run(const QVariantMap &files, const QVariantMap &params, int token)
+{
+    emit finished(runNow(files, params), token);
+}
