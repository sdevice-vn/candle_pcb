+// ---------------------------------------------------------------- parameters
+
+QVariant frmGerber::paramValue(const QString &key) const
+{
+    QWidget *w = m_widgets.value(key);
+    if (!w) return m_defaults.value(key);
+    if (QCheckBox *cb = qobject_cast<QCheckBox *>(w)) return cb->isChecked();
+    if (QComboBox *cbo = qobject_cast<QComboBox *>(w)) return cbo->currentData().toString();
+    if (QDoubleSpinBox *sp = qobject_cast<QDoubleSpinBox *>(w)) return sp->value();
+    return QVariant();
+}
+
+void frmGerber::setParamValue(const QString &key, const QVariant &v)
+{
+    QWidget *w = m_widgets.value(key);
+    if (!w) return;
+    if (QCheckBox *cb = qobject_cast<QCheckBox *>(w)) cb->setChecked(v.toBool());
+    else if (QComboBox *cbo = qobject_cast<QComboBox *>(w)) { int i = cbo->findData(v.toString()); if (i >= 0) cbo->setCurrentIndex(i); }
+    else if (QDoubleSpinBox *sp = qobject_cast<QDoubleSpinBox *>(w)) sp->setValue(v.toDouble());
+}
+
+void frmGerber::setParam(const QString &key, const QVariant &value)
+{
+    setParamValue(key, value);
+}
+
+QVariantMap frmGerber::allParams() const
+{
+    QVariantMap m;
+    for (QMap<QString, QWidget *>::const_iterator it = m_widgets.begin(); it != m_widgets.end(); ++it)
+        m[it.key()] = paramValue(it.key());
+    return m;
+}
+
+// Same dependency rules as syncVisibility() of the HTML tool
+void frmGerber::syncEnabled()
+{
+    bool big = paramValue("c_on").toBool();
+    bool iso = paramValue("e_mode").toString() == "isolate" || big;
+    bool probe = paramValue("g_probe").toBool();
+    bool merge = paramValue("d_merge").toBool();
+    bool widen = paramValue("d_widen").toBool();
+    bool vbit = paramValue("e_tool").toString() == "v";
+    QString home = paramValue("g_homeMode").toString();
+    bool probeWork = probe && paramValue("g_probeAt").toString() == "work";
+
+    #define EN(key, cond) if (m_widgets.contains(key)) m_widgets[key]->setEnabled(cond)
+    EN("e_mode", !big);
+    const char *bigKeys[] = { "dia", "depth", "step", "ovl", "feed", "plunge", "rpm" };
+    for (unsigned i = 0; i < sizeof(bigKeys) / sizeof(bigKeys[0]); i++) EN((QString("c_") + bigKeys[i]), big);
+    EN("d_split", !merge);
+    EN("d_bitL", !merge);
+    EN("e_iso", iso);
+    const char *pk[] = { "probeFirst", "probeAt", "plate", "probeRange", "probeFast", "probeFeed", "probeLift", "probePause" };
+    for (unsigned i = 0; i < sizeof(pk) / sizeof(pk[0]); i++) EN((QString("g_") + pk[i]), probe);
+    EN("g_probeX", probeWork);
+    EN("g_probeY", probeWork);
+    EN("g_homeX", home != "g28");
+    EN("g_homeY", home != "g28");
+    EN("g_tcZ", home == "g53");
+    EN("d_feedxy", widen);
+    EN("d_pitch", widen);
+    EN("d_pilot", widen);
+    EN("e_dia", !vbit);
+    EN("e_vang", vbit);
+    EN("e_tip", vbit);
+    #undef EN
+}
+
+void frmGerber::onParamChanged()
+{
+    if (m_loading) return;
+    syncEnabled();
+    saveSettings();
+    m_timer.start(450);
+}
+
+void frmGerber::saveSettings()
+{
+    if (m_loading || m_settingsFile.isEmpty()) return;
+    QSettings s(m_settingsFile, QSettings::IniFormat);
+    s.beginGroup("gerber");
+    s.setValue("lastDir", m_lastDir);
+    QVariantMap p = allParams();
+    for (QVariantMap::const_iterator it = p.begin(); it != p.end(); ++it) s.setValue("p_" + it.key(), it.value());
+    s.endGroup();
+}
+
+void frmGerber::loadSettings()
+{
+    if (m_settingsFile.isEmpty()) return;
+    QSettings s(m_settingsFile, QSettings::IniFormat);
+    s.beginGroup("gerber");
+    m_lastDir = s.value("lastDir").toString();
+    for (QMap<QString, QWidget *>::const_iterator it = m_widgets.begin(); it != m_widgets.end(); ++it) {
+        QString k = "p_" + it.key();
+        if (s.contains(k)) setParamValue(it.key(), s.value(k));
+    }
+    s.endGroup();
+}
+
+void frmGerber::onSaveParams()
+{
+    QString fn = QFileDialog::getSaveFileName(this, U("Lưu thông số"), m_lastDir + "/pcb_thong_so.json", "JSON (*.json)");
+    if (fn.isEmpty()) return;
+    QJsonObject o;
+    QVariantMap p = allParams();
+    for (QVariantMap::const_iterator it = p.begin(); it != p.end(); ++it) o[it.key()] = QJsonValue::fromVariant(it.value());
+    QFile f(fn);
+    if (f.open(QIODevice::WriteOnly)) f.write(QJsonDocument(o).toJson());
+}
+
+void frmGerber::onLoadParams()
+{
+    QString fn = QFileDialog::getOpenFileName(this, U("Nạp thông số"), m_lastDir, "JSON (*.json)");
+    if (fn.isEmpty()) return;
+    QFile f(fn);
+    if (!f.open(QIODevice::ReadOnly)) return;
+    QJsonDocument d = QJsonDocument::fromJson(f.readAll());
+    if (!d.isObject()) { QMessageBox::warning(this, windowTitle(), U("File thông số không hợp lệ.")); return; }
+    m_loading = true;
+    QJsonObject o = d.object();
+    for (QJsonObject::const_iterator it = o.begin(); it != o.end(); ++it) setParamValue(it.key(), it.value().toVariant());
+    m_loading = false;
+    onParamChanged();
+}
+
+void frmGerber::onResetParams()
+{
+    m_loading = true;
+    for (QMap<QString, QVariant>::const_iterator it = m_defaults.begin(); it != m_defaults.end(); ++it) setParamValue(it.key(), it.value());
+    m_loading = false;
+    onParamChanged();
+}
+
+// ---------------------------------------------------------------- files
+
+QString frmGerber::classify(const QString &name, const QString &text) const
+{
+    QString ext = QFileInfo(name).suffix().toLower(), low = name.toLower(), head = text.left(600);
+    if (QRegExp("^\\s*M48").indexIn(head) >= 0 || QStringList({ "drl", "xln", "drd", "exc" }).contains(ext)) return "drill";
+    if (!text.contains("%FS") && ext == "txt" && QRegExp("T\\d+").indexIn(head) >= 0) return "drill";
+    if (ext == "gbl" || QRegExp("bottom|b_cu|gbl").indexIn(low) >= 0) return "bottom";
+    if (QStringList({ "gm1", "gm2", "gm3", "gko", "gml", "gm13" }).contains(ext) ||
+        QRegExp("outline|edge|border|profile|gko|gm1").indexIn(low) >= 0) return "outline";
+    return QString();
+}
+
+bool frmGerber::setFile(const QString &kind, const QString &name, const QString &text)
+{
+    if (!m_slots.contains(kind)) return false;
+    Slot &s = m_slots[kind];
+    s.name = name;
+    s.text = text;
+    s.status->setText(name + U(" – ") + QString::number(text.size() / 1024.0, 'f', 1) + " KB");
+    s.status->setStyleSheet("color: #2e9d57");
+    s.clear->setEnabled(true);
+    return true;
+}
+
+bool frmGerber::setFileFromPath(const QString &path, const QString &forceKind)
+{
+    QFile f(path);
+    if (!f.open(QIODevice::ReadOnly)) {
+        showMessage(U("Không mở được file: ") + path);
+        return false;
+    }
+    QString text = QString::fromUtf8(f.readAll());
+    QString name = QFileInfo(path).fileName();
+    QString kind = forceKind.isEmpty() ? classify(name, text) : forceKind;
+    m_lastDir = QFileInfo(path).absolutePath();
+    if (kind.isEmpty()) {
+        showMessage(U("Không nhận ra file \"") + name + U("\". Hãy bấm đúng nút Chọn của loại file tương ứng."));
+        return false;
+    }
+    return setFile(kind, name, text);
+}
+
+void frmGerber::onPickFile(const QString &kind)
+{
+    QString filter = kind == "bottom" ? U("Gerber lớp đồng (*.gbl *.gbr *.ger *.gb *.txt);;Mọi tệp (*)")
+                   : kind == "drill" ? U("File khoan (*.txt *.drl *.xln *.nc *.drd *.exc);;Mọi tệp (*)")
+                   : U("File viền (*.gm1 *.gm2 *.gko *.gml *.gbr *.ger *.txt);;Mọi tệp (*)");
+    QString fn = QFileDialog::getOpenFileName(this, U("Chọn file"), m_lastDir, filter);
+    if (fn.isEmpty()) return;
+    if (setFileFromPath(fn, kind)) { saveSettings(); m_timer.start(0); }
+}
+
+void frmGerber::onClearFile(const QString &kind)
+{
+    Slot &s = m_slots[kind];
+    s.name.clear();
+    s.text.clear();
+    s.status->setText(U("Chưa có file"));
+    s.status->setStyleSheet("color: gray");
+    s.clear->setEnabled(false);
+    m_timer.start(0);
+}
+
+void frmGerber::dragEnterEvent(QDragEnterEvent *e)
+{
+    if (e->mimeData()->hasUrls()) e->acceptProposedAction();
+}
+
+void frmGerber::dropEvent(QDropEvent *e)
+{
+    bool any = false;
+    foreach (const QUrl &u, e->mimeData()->urls()) {
+        if (u.isLocalFile()) any = setFileFromPath(u.toLocalFile()) || any;
+    }
+    if (any) { saveSettings(); m_timer.start(0); }
+}
+
+// ---------------------------------------------------------------- compute
+
+void frmGerber::startCompute()
+{
+    if (m_busy) { m_dirty = true; return; }
+    QVariantMap files;
+    bool any = false;
+    for (QMap<QString, Slot>::const_iterator it = m_slots.begin(); it != m_slots.end(); ++it) {
+        if (it.value().text.isEmpty()) continue;
+        QVariantMap f;
+        f["name"] = it.value().name;
+        f["text"] = it.value().text;
+        files[it.key()] = f;
+        any = true;
+    }
+    if (!any) {
+        m_combined.clear(); m_parts.clear(); m_probe.clear();
+        m_preview->clear();
+        m_warns->clear(); m_summary->clear(); m_status->clear();
+        m_stagesTable->setRowCount(0); m_holesTable->setRowCount(0);
+        m_cboLoad->clear(); m_cmdLoad->setEnabled(false); m_cmdSave->setEnabled(false);
+        return;
+    }
+    m_busy = true;
+    m_dirty = false;
+    m_pendingToken = ++m_token;
+    m_status->setText(U("Đang tính..."));
+    QApplication::setOverrideCursor(Qt::BusyCursor);
+    emit requestRun(files, allParams(), m_pendingToken);
+}
+
+void frmGerber::onResult(const QString &json, int token)
+{
+    m_busy = false;
+    QApplication::restoreOverrideCursor();
+    if (m_dirty || token != m_token) { startCompute(); return; }
+    QJsonObject r = QJsonDocument::fromJson(json.toUtf8()).object();
+    showResult(r);
+    emit computed(r["ok"].toBool());
+}
+
+void frmGerber::showResult(const QJsonObject &r)
+{
+    // warnings
+    QStringList w;
+    foreach (const QJsonValue &v, r["warns"].toArray())
+        w << QString("<div style='color:#c0392b; margin-bottom:3px'>&#9888; %1</div>").arg(v.toString().toHtmlEscaped());
+    m_warns->setText(w.join(""));
+
+    m_stagesTable->setRowCount(0);
+    m_holesTable->setRowCount(0);
+    m_cboLoad->clear();
+    m_combined.clear(); m_parts.clear(); m_partTitles.clear(); m_probe.clear();
+
+    if (!r["ok"].toBool()) {
+        m_summary->clear();
+        m_status->setText(U("Có lỗi, xem cảnh báo bên trên."));
+        m_cmdLoad->setEnabled(false);
+        m_cmdSave->setEnabled(false);
+        if (r["empty"].toBool()) m_preview->clear();
+        return;
+    }
+
+    QJsonObject sum = r["summary"].toObject();
+    m_summary->setText(U("Mạch %1 × %2 mm · ước tính %3 chạy máy (chưa tính thời gian thay mũi) · thay mũi %4 lần · %5 dòng · tính trong %6 ms")
+        .arg(sum["bw"].toDouble(), 0, 'f', 1).arg(sum["bh"].toDouble(), 0, 'f', 1).arg(sum["timeText"].toString())
+        .arg(sum["changes"].toInt()).arg(sum["lineCount"].toInt()).arg(sum["ms"].toInt()));
+    m_status->setText(U("Đã tính xong."));
+
+    QJsonArray stages = r["stages"].toArray();
+    m_stagesTable->setRowCount(stages.size());
+    for (int i = 0; i < stages.size(); i++) {
+        QJsonObject s = stages[i].toObject();
+        m_stagesTable->setItem(i, 0, new QTableWidgetItem(QString::number(i + 1)));
+        m_stagesTable->setItem(i, 1, new QTableWidgetItem(s["title"].toString()));
+        m_stagesTable->setItem(i, 2, new QTableWidgetItem(s["toolText"].toString() + " · S" + QString::number(s["rpm"].toInt())));
+        m_stagesTable->setItem(i, 3, new QTableWidgetItem(s["meta"].toString() + U(" · ≈ ") + s["timeText"].toString()));
+    }
+    m_stagesTable->resizeColumnsToContents();
+    m_stagesTable->horizontalHeader()->setStretchLastSection(true);
+
+    double bitS = r["bitS"].toDouble();
+    bool widen = r["widen"].toBool();
+    QJsonArray rows = r["holeRows"].toArray();
+    m_holesTable->setRowCount(rows.size());
+    for (int i = 0; i < rows.size(); i++) {
+        QJsonObject h = rows[i].toObject();
+        double d = h["d"].toDouble(), bit = h["bit"].toDouble();
+        QString note;
+        if (bit > 0 && d > bit + 0.15) note = widen ? U("phay mở rộng") : U("lỗ ra nhỏ hơn ") + QString::number(d, 'f', 2) + " mm";
+        m_holesTable->setItem(i, 0, new QTableWidgetItem(U("Ø ") + QString::number(d, 'f', 2) + " mm"));
+        m_holesTable->setItem(i, 1, new QTableWidgetItem(QString::number(h["n"].toInt())));
+        m_holesTable->setItem(i, 2, new QTableWidgetItem(bit > 0 ? U("mũi ") + QString::number(bit) + " mm" : U("bỏ qua")));
+        QTableWidgetItem *ni = new QTableWidgetItem(note);
+        if (!note.isEmpty() && !widen) ni->setForeground(QColor("#c0392b"));
+        m_holesTable->setItem(i, 3, ni);
+    }
+    m_holesTable->resizeColumnsToContents();
+    m_holesTable->horizontalHeader()->setStretchLastSection(true);
+
+    if (r.contains("preview")) m_preview->setData(r["preview"].toObject(), bitS);
+
+    if (stages.size() && r.contains("combined")) {
+        m_combined = r["combined"].toString();
+        foreach (const QJsonValue &p, r["parts"].toArray()) m_parts << p.toString();
+        m_cboLoad->addItem(U("Bản gộp (tất cả công đoạn)"), -1);
+        m_partTitles << "pcb_gcode_gop";
+        for (int i = 0; i < stages.size(); i++) {
+            QJsonObject s = stages[i].toObject();
+            m_cboLoad->addItem(QString("%1. %2 (%3)").arg(i + 1).arg(s["title"].toString(), s["toolText"].toString()), i);
+            m_partTitles << QString("pcb_buoc%1_%2").arg(i + 1).arg(s["id"].toString());
+        }
+        if (!r["probe"].isNull() && r["probe"].isString()) {
+            m_probe = r["probe"].toString();
+            m_cboLoad->addItem(U("Chương trình dò Z"), -2);
+        }
+    }
+    m_cmdLoad->setEnabled(m_cboLoad->count() > 0);
+    m_cmdSave->setEnabled(m_cboLoad->count() > 0);
+}
+
+void frmGerber::showMessage(const QString &text)
+{
+    m_status->setText(text);
+}
+
+// ---------------------------------------------------------------- output
+
+QStringList frmGerber::selectedGcodeLines(QString *title, QString *fileName) const
+{
+    int id = m_cboLoad->currentData().toInt();
+    QString text;
+    if (id == -1) { text = m_combined; *fileName = "pcb_gcode_gop.nc"; *title = U("PCB – bản gộp"); }
+    else if (id == -2) { text = m_probe; *fileName = "pcb_do_Z.nc"; *title = U("PCB – dò Z"); }
+    else if (id >= 0 && id < m_parts.size()) {
+        text = m_parts[id];
+        *fileName = m_partTitles.value(id + 1) + ".nc";
+        *title = m_cboLoad->currentText();
+    }
+    QStringList lines = text.split('\n');
+    while (!lines.isEmpty() && lines.last().trimmed().isEmpty()) lines.removeLast();
+    return lines;
+}
+
+QString frmGerber::currentGcode() const
+{
+    QString t, f;
+    return selectedGcodeLines(&t, &f).join("\n") + "\n";
+}
+
+void frmGerber::onLoadClicked()
+{
+    QString title, fn;
+    QStringList lines = selectedGcodeLines(&title, &fn);
+    if (lines.isEmpty()) return;
+    emit loadGcode(lines, title);
+    m_status->setText(U("Đã nạp \"") + title + U("\" vào Candle (") + QString::number(lines.size()) + U(" dòng)."));
+}
+
+void frmGerber::onSaveClicked()
+{
+    QString title, fn;
+    QStringList lines = selectedGcodeLines(&title, &fn);
+    if (lines.isEmpty()) return;
+    QString path = QFileDialog::getSaveFileName(this, U("Lưu G-code"), m_lastDir + "/" + fn,
+                                                U("G-Code (*.nc *.ngc *.tap *.txt)"));
+    if (path.isEmpty()) return;
+    QFile f(path);
+    if (!f.open(QIODevice::WriteOnly | QIODevice::Text)) {
+        QMessageBox::warning(this, windowTitle(), U("Không ghi được file: ") + path);
+        return;
+    }
+    f.write(lines.join("\n").toUtf8() + "\n");
+    m_lastDir = QFileInfo(path).absolutePath();
+    m_status->setText(U("Đã lưu ") + path);
+}
