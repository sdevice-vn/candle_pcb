+  if (c && c.text === f.text) return c.parsed;
+  var parsed = null;
+  try {
+    if (kind === 'drill') {
+      parsed = PCB.parseExcellon(f.text);
+      if (!parsed.holes.length) throw new Error('không thấy lỗ khoan nào');
+    } else {
+      parsed = PCB.parseGerber(f.text);
+      if (!parsed.prims.length) throw new Error('không đọc được đối tượng nào');
+    }
+  } catch (e) {
+    warns.push('Lỗi đọc "' + f.name + '": ' + e.message);
+    delete __pcbCache[kind];
+    return null;
+  }
+  __pcbCache[kind] = { text: f.text, parsed: parsed };
+  return parsed;
+}
+
