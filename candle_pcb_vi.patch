+          if (k === 1) w.move('G1', null, null, 0, o.plunge);
+          cutLoopPass(w, pts, zPrev, zk, true, o.feed, o.plunge, tabInfo, tabZ);
+        } else {
+          w.move('G1', null, null, zPrev === 0 ? 0 : zPrev, o.plunge);
+          w.move('G1', null, null, zk, o.plunge);
+          cutLoopPass(w, pts, zk, zk, false, o.feed, o.plunge, tabInfo, tabZ);
+        }
+        zPrev = zk;
+      }
+      if (o.ramp) cutLoopPass(w, pts, zEnd, zEnd, false, o.feed, o.plunge, tabInfo, tabZ); // flat finishing lap
+      w.move('G0', null, null, P.travelZ);
+    });
+    return w;
+  }
+
+  // ---------- full program ----------
+  function ascii(t) { return String(t).normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D'); }
+  // Về vị trí thay mũi: luôn M5 + nâng Z trước khi chạy XY.
+  function homeBlock(P) {
+    var l = ['M5'];
+    if (P.homeMode === 'g53') {
+      l.push('G53 G0 Z' + fmt(P.tcZ) + ' ; Z máy (cần đã homing)');
+      l.push('G53 G0 X' + fmt(P.homeX) + ' Y' + fmt(P.homeY) + ' ; vị trí thay mũi (tọa độ máy)');
+    } else {
+      l.push('G0 Z' + fmt(P.safeZ));
+      if (P.homeMode === 'g28') l.push('G28'); else l.push('G0 X' + fmt(P.homeX) + ' Y' + fmt(P.homeY));
+    }
+    return l;
+  }
+  function header(P, title, extra) {
+    var h = ['; ' + title, '; Tạo bởi công cụ PCB Gerber → G-code (GRBL)', 'G21 ; mm', 'G90 ; tọa độ tuyệt đối', 'G17', 'G94', 'G54 ; hệ tọa độ phôi (khớp G10 L20 P1)'];
+    if (extra) extra.forEach(function (e) { h.push(e); });
+    return h;
+  }
+  function spindleOn(S, P) {
+    var l = ['M3 S' + S];
+    if (P.spin > 0) l.push('G4 P' + fmt(P.spin) + ' ; chờ trục quay ổn định');
+    return l;
+  }
+  // Dò Z: G91 để Z là khoảng dịch (không phải tọa độ tuyệt đối), dò nhanh -> nhấc -> dò chậm.
+  function probeBlock(P) {
+    var b = ['; --- Dò Z bằng G38.2: Z0 = mặt phôi ---'];
+    if (P.probeAt === 'work') b.push('G0 X' + fmt(P.probeX) + ' Y' + fmt(P.probeY) + ' ; tới điểm dò (tọa độ phôi)');
+    b.push('G91 ; Z dò là khoảng dịch tương đối');
+    b.push('G38.2 Z-' + fmt(P.probeRange) + ' F' + fmt(P.probeFast) + ' ; dò nhanh (báo lỗi nếu không chạm)');
+    b.push('G0 Z' + fmt(P.probeLift));
+    b.push('G38.2 Z-' + fmt(P.probeLift + 1) + ' F' + fmt(P.probeFeed) + ' ; dò chậm');
+    b.push('G90');
+    b.push('G10 L20 P1 Z' + fmt(P.plate) + ' ; đặt Z0 (đã trừ bề dày tấm dò)');
+    b.push('G0 Z' + fmt(P.safeZ));
+    if (P.probePause) {
+      b.push('(MSG, Do Z xong - thao kep cap/tam do roi nhan Resume)');
+      b.push('M0 ; tạm dừng: tháo kẹp cáp/tấm dò trước khi bật trục');
+    }
+    return b;
+  }
+  // File dò Z riêng: chạy sau khi gắn mũi mới, rồi nạp file bước tiếp theo (an toàn với bản đồ cao Candle)
+  function probeProgram(P) {
+    var f = header(P, 'PCB – dò Z (G38.2)', ['G0 Z' + fmt(P.safeZ),
+      '; Dùng sau khi gắn mũi mới. ' + (P.probeAt === 'work' ? 'Mũi sẽ tới điểm dò X,Y theo gốc phôi.' : 'Mũi dò ngay tại vị trí XY hiện tại (đặt tấm dò dưới mũi).')]);
+    probeBlock(P).forEach(function (x) { f.push(x); });
+    f.push('M30');
+    return f.join('\n') + '\n';
+  }
+
+  function assemble(stages, P, combined) {
+    // stages: [{title, toolText, rpm, w}]
+    function stageBlock(st, idx, withChange) {
+      var b = [];
+      var sameTool = idx > 0 && st.key && stages[idx - 1].key === st.key;
+      var doProbe = withChange && P.probe && (idx > 0 ? !sameTool : P.probeFirst);
+      if (withChange && sameTool) b.push('; (cùng mũi với bước trước: không thay mũi, không dò lại Z)');
+      if (withChange && ((idx > 0 && !sameTool) || doProbe)) {
+        var first = idx === 0;
+        b.push('; ===== ' + (first ? 'GẮN MŨI ĐẦU: ' : 'THAY MŨI: ') + st.toolText + ' =====');
+        homeBlock(P).forEach(function (x) { b.push(x); });
+        b.push('(MSG, ' + (first ? 'Gan mui: ' : 'Thay mui: ') + ascii(st.toolText) +
+          (doProbe ? ' - dat tam do/kep cap do Z, nhan Resume)' : ' - xong nhan Resume)'));
+        b.push('M0 ; tạm dừng để ' + (first ? 'gắn' : 'thay') + ' mũi');
+        if (doProbe) probeBlock(P).forEach(function (x) { b.push(x); });
+      }
+      b.push('; ===== ' + st.title + ' =====');
+      spindleOn(st.rpm, P).forEach(function (x) { b.push(x); });
+      st.w.lines.forEach(function (x) { b.push(x); });
+      b.push('M5');
+      b.push('G0 Z' + fmt(P.safeZ));
+      return b;
+    }
+    var main = header(P, 'PCB – chương trình gộp (' + stages.length + ' công đoạn)', ['G0 Z' + fmt(P.safeZ)]);
+    stages.forEach(function (st, i) { stageBlock(st, i, true).forEach(function (x) { main.push(x); }); });
+    homeBlock(P).forEach(function (x) { main.push(x); });
+    main.push('M30');
+    var parts = stages.map(function (st, i) {
+      var f = header(P, 'PCB – ' + st.title, ['G0 Z' + fmt(P.safeZ),
+        '; Gắn mũi: ' + st.toolText + ', đặt Z0 trên mặt đồng rồi chạy.',
+        '; File này không có G38/M0 nên dùng được với bản đồ cao (Heightmap) của Candle.']);
+      stageBlock(st, i, false).forEach(function (x) { f.push(x); });
+      homeBlock(P).forEach(function (x) { f.push(x); });
+      f.push('M30');
+      return f.join('\n') + '\n';
+    });
+    return { combined: main.join('\n') + '\n', parts: parts, probe: P.probe ? probeProgram(P) : null };
+  }
+
+  return {
+    SCALE: SCALE, parseGerber: parseGerber, parseExcellon: parseExcellon, analyze: analyze, makeTransform: makeTransform,
+    buildCopper: buildCopper, toClip: toClip, fromClip: fromClip, posOrient: posOrient, union: union, diff: diff,
+    CLP: CL, planEngrave: planEngrave, planClear: planClear, planOutline: planOutline, genEngrave: genEngrave, genDrill: genDrill,
+    genOutline: genOutline, assemble: assemble, probeProgram: probeProgram, fmt: fmt, areaMm2: areaMm2, pathLen: pathLen, chainOutline: chainOutline
+  };
+})();
+if (typeof module !== 'undefined') module.exports = PCB;
