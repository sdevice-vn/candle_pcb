+QWidget *frmGerber::buildParamsWidget()
+{
+    QWidget *host = new QWidget;
+    QVBoxLayout *vl = new QVBoxLayout(host);
+    vl->setContentsMargins(0, 0, 4, 0);
+
+    foreach (const QJsonValue &gv, m_groups) {
+        QJsonObject g = gv.toObject();
+        QString gid = g["id"].toString();
+        QGroupBox *box = new QGroupBox(g["title"].toString());
+        box->setCheckable(true);
+        box->setChecked(g["open"].toBool());
+        QVBoxLayout *bl = new QVBoxLayout(box);
+        bl->setContentsMargins(6, 4, 6, 6);
+        QWidget *content = new QWidget;
+        QFormLayout *fl = new QFormLayout(content);
+        fl->setContentsMargins(0, 0, 0, 0);
+        fl->setFieldGrowthPolicy(QFormLayout::AllNonFixedFieldsGrow);
+        fl->setRowWrapPolicy(QFormLayout::WrapLongRows);
+        bl->addWidget(content);
+        content->setVisible(box->isChecked());
+        connect(box, &QGroupBox::toggled, content, &QWidget::setVisible);
+
+        foreach (const QJsonValue &fv, g["f"].toArray()) {
+            QJsonObject f = fv.toObject();
+            QString t = f["t"].toString();
+            if (t == "note") {
+                QLabel *n = new QLabel(f["l"].toString());
+                n->setWordWrap(true);
+                n->setStyleSheet("color: gray; font-size: 11px");
+                fl->addRow(n);
+                continue;
+            }
+            QString key = gid + "_" + f["id"].toString();
+            QString label = f["l"].toString();
+            QLabel *lab = new QLabel(label);
+            lab->setWordWrap(false);
+            QWidget *w = NULL;
+            if (t == "cb") {
+                QCheckBox *cb = new QCheckBox;
+                cb->setChecked(f["v"].toBool());
+                m_defaults[key] = f["v"].toBool();
+                connect(cb, SIGNAL(toggled(bool)), this, SLOT(onParamChanged()));
+                w = cb;
+            } else if (t == "sel") {
+                QComboBox *cbo = new QComboBox;
+                foreach (const QJsonValue &ov, f["o"].toArray()) {
+                    QJsonArray o = ov.toArray();
+                    cbo->addItem(o[1].toString(), o[0].toString());
+                }
+                int idx = cbo->findData(f["v"].toString());
+                cbo->setCurrentIndex(idx < 0 ? 0 : idx);
+                m_defaults[key] = f["v"].toString();
+                cbo->setSizeAdjustPolicy(QComboBox::AdjustToMinimumContentsLengthWithIcon);
+                cbo->setMinimumContentsLength(8);
+                connect(cbo, SIGNAL(currentIndexChanged(int)), this, SLOT(onParamChanged()));
+                w = cbo;
+            } else {
+                QDoubleSpinBox *sp = new QDoubleSpinBox;
+                sp->setLocale(QLocale::c());
+                QString unit = f["u"].toString();
+                double step = f["step"].isDouble() ? f["step"].toDouble() : 1.0;
+                bool intLike = (unit == "S" || unit == U("vòng") || unit == U("cầu"));
+                sp->setDecimals(intLike ? 0 : (step < 0.1 ? 3 : 2));
+                sp->setRange(f["min"].isDouble() ? f["min"].toDouble() : -100000.0, 1000000.0);
+                sp->setSingleStep(step);
+                sp->setValue(f["v"].toDouble());
+                sp->setKeyboardTracking(false);
+                if (!unit.isEmpty()) sp->setSuffix(" " + unit);
+                sp->setAlignment(Qt::AlignRight);
+                sp->setMinimumWidth(110);
+                sp->setMaximumWidth(150);
+                m_defaults[key] = f["v"].toDouble();
+                connect(sp, SIGNAL(valueChanged(double)), this, SLOT(onParamChanged()));
+                w = sp;
+            }
+            w->setProperty("paramKey", key);
+            m_widgets[key] = w;
+            if (t == "sel") { fl->addRow(lab); fl->addRow(w); }   // label above the (wide) drop-down
+            else fl->addRow(lab, w);
+        }
+        vl->addWidget(box);
+    }
+    vl->addStretch(1);
+    return host;
+}
